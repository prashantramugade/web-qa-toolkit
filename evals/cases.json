{
  "description": "What the toolkit must find in evals/demo-app (a small shop with deliberately seeded defects), and what it must NOT report.",
  "auto": [
    "page-http-error",
    "broken-internal-link",
    "soft-404",
    "link-to-missing-page",
    "console-errors",
    "subresource-http-error",
    "broken-image",
    "no-lang",
    "seo-no-meta-description",
    "seo-multiple-h1",
    "mobile-horizontal-overflow",
    "reflected-input-unencoded",
    "form-field-no-label",
    "email-field-wrong-type",
    "cookie-no-httponly",
    "placeholder-links",
    "blank-no-noopener",
    "login-page-cacheable",
    "version-disclosure",
    "missing-csp",
    "vague-link-text",
    "no-skip-link",
    "seo-no-robots"
  ],
  "explore": [
    "explore-empty-submit-accepted",
    "explore-invalid-email-accepted",
    "explore-whitespace-accepted",
    "explore-search-case-sensitive",
    "explore-cart-quantity-mismatch",
    "explore-nonpositive-quantity-accepted",
    "explore-mouse-only-control"
  ],
  "notExpected": [
    { "rule": "mobile-horizontal-overflow", "page": "/slow", "why": "the page is judged after its late styles and content have arrived" },
    { "rule": "no-lang", "page": "/shop", "why": "only /about lacks a language" },
    { "rule": "explore-empty-submit-accepted", "page": "/login", "why": "login forms are never filled or submitted" }
  ]
}
